# Env file for the Drive app-dev and celery-dev containers in the e2e stack.
#
# Derived from e2e/.drive/env.d/development/{common,common.e2e,postgresql,
# postgresql.e2e}. Every hostname that pointed at a compose service name
# (postgresql, redis, minio) now reads localhost, because every container in
# this stack runs with network_mode: host (see e2e/README.md).

# Django
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=ThisIsAnExampleKeyForDevPurposeOnly
DJANGO_SETTINGS_MODULE=drive.settings
DJANGO_CONFIGURATION=Development
DJANGO_SUPERUSER_PASSWORD=admin

# Logging
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

PYTHONPATH=/app

# Database (env.d/development/postgresql + postgresql.e2e, host DB_HOST/PORT
# rewritten to localhost:5432)
POSTGRES_DB=drive_e2e
POSTGRES_USER=dinum
POSTGRES_PASSWORD=pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drive_e2e
DB_USER=dinum
DB_PASSWORD=pass

# Cache and celery broker (both point at the redis service's own port)
REDIS_URL=redis://localhost:6379/0
DJANGO_CELERY_BROKER_URL=redis://localhost:6379/0

# Mail: DJANGO_EMAIL_HOST/DJANGO_EMAIL_PORT stay unset on purpose. The
# backend-development image ships no compiled mail templates, so any
# notification email 500s in send_invitation_email (TemplateDoesNotExist,
# mail/html/invitation.html); Drive's send_email (core/models.py) skips
# sending cleanly when EMAIL_HOST is unset. This suite's login goes through
# the e2e auth bypass (POST /api/v1.0/e2e/user-auth/), not email, so no SMTP
# is needed. DJANGO_EMAIL_URL_APP only feeds email templates, no frontend
# runs in this stack.
DJANGO_EMAIL_BRAND_NAME="excalidraw-wopi e2e"
DJANGO_EMAIL_URL_APP=http://localhost:8000
USER_RECONCILIATION_FORM_URL=http://localhost:8000

# Media (minio), AWS_S3_DOMAIN_REPLACE keeps presigned URLs on localhost so a
# host process (our seed script) can reach the same minio the app-dev
# container uses
AWS_S3_ACCESS_KEY_ID=drive
AWS_S3_SECRET_ACCESS_KEY=password
AWS_S3_REGION_NAME=eu-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_DOMAIN_REPLACE=http://localhost:9000
MEDIA_BASE_URL=http://localhost:8000

# OIDC dev values, kept present so settings.py boots (Base.post_setup does
# not require them), but they point nowhere: this stack ships no keycloak.
# The e2e auth bypass (POST /api/v1.0/e2e/user-auth/) replaces the OIDC
# login flow entirely.
OIDC_OP_JWKS_ENDPOINT=http://localhost:8083/realms/drive/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8083/realms/drive/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://localhost:8083/realms/drive/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://localhost:8083/realms/drive/protocol/openid-connect/userinfo
OIDC_RP_CLIENT_ID=drive
OIDC_RP_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email"
LOGIN_REDIRECT_URL=http://localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://localhost:8000
LOGOUT_REDIRECT_URL=http://localhost:8000
OIDC_REDIRECT_ALLOWED_HOSTS=localhost:8000
OIDC_OP_URL=http://localhost:8083/realms/drive
OIDC_RESOURCE_SERVER_ENABLED=False

# WOPI setup. Only excalidraw is registered: this stack carries no
# collabora or onlyoffice container.
WOPI_CLIENTS=excalidraw
WOPI_EXCALIDRAW_DISCOVERY_URL=http://localhost:8080/hosting/discovery
WOPI_SRC_BASE_URL=http://localhost:8000

# Malware detection: report every upload as safe right away. Drive's own
# e2e env (common.e2e) makes the same choice, so uploads leave PENDING
# state without a scan-pending window to poll through.
MALWARE_DETECTION_BACKEND=lasuite.malware_detection.backends.dummy.DummyBackend
