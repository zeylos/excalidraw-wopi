# Env file for our own binary in the e2e stack. The binary runs on the
# host, not in compose (see e2e/README.md), but Makefile e2e-up loads this
# file into its environment before starting it. The Go integration suite
# (e2e/integration/drive_test.go) loads config.Load() and proof.Load()
# itself, so `make test-drive-integration` sources this same file before
# running go test: both processes must resolve the same proof key and
# session secret.
EXCALIDRAW_WOPI_LISTEN_ADDR=:8080
EXCALIDRAW_WOPI_PUBLIC_URL=http://localhost:8080
EXCALIDRAW_WOPI_PROOF_KEY_PATH=e2e/.run/proof-key.pem
# dev-only fixed secret (44 bytes), never use this value outside the e2e stack
EXCALIDRAW_WOPI_SESSION_SECRET=dev-only-e2e-fixed-session-secret-do-not-use
EXCALIDRAW_WOPI_WOPI_ALLOWED_ORIGINS=http://localhost:8000
# The dockerized-Drive smoke suite launches through the real Drive flow,
# which never sets testHooks (unlike --fake-host dev mode), so it needs
# this instance's own knob for window.__excaTest
# (internal/app/testhooks.go). e2e-only; never set this in production.
EXCALIDRAW_WOPI_TEST_HOOKS=1
